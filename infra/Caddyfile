# The site is proxied by Cloudflare: the visitor's address is CF-Connecting-IP, trusted only from Cloudflare's
# published ranges (https://www.cloudflare.com/ips/, checked 2026-10-09), so a request that reaches the server directly
# cannot set it. The API gets it as X-Real-IP (the contact form's daily limit is per visitor, not per Cloudflare edge).
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# HTTPS certificates are obtained and renewed automatically for {$SITE_DOMAIN}.
{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# REST API and its OpenAPI docs
	handle /api/* {
		reverse_proxy api:8000 {
			header_up X-Real-IP {client_ip}
		}
	}
	handle /docs* {
		reverse_proxy api:8000
	}
	handle /openapi.json {
		reverse_proxy api:8000
	}

	# Umami's tracker and its page-view endpoint, first-party so blockers of third-party trackers leave them alone.
	# Only these two paths: the dashboard and its login are on stats.{$SITE_DOMAIN}.
	@umami path /u/script.js /u/api/send
	handle @umami {
		uri strip_prefix /u
		reverse_proxy umami:3000 {
			header_up X-Real-IP {client_ip}
		}
	}

	handle {
		reverse_proxy web:3000
	}

	log
}

# Umami dashboard (page-view statistics), behind its own login
stats.{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy umami:3000 {
		header_up X-Real-IP {client_ip}
	}
	log
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
