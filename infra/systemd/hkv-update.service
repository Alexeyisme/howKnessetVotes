[Unit]
Description=hkv: load new Knesset votes (scripts/prod.sh run --rm updater)
After=docker.service
Requires=docker.service
OnFailure=hkv-alert@%n.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/srv/hkv
# the lock keeps it from overlapping a quick run (hkv-update-quick): it waits for one to finish
ExecStart=/usr/bin/flock /run/lock/hkv-update.lock /srv/hkv/scripts/prod.sh run --rm updater
TimeoutStartSec=2h
